# =========================================================
# RateGuard Environment Configuration
# =========================================================

# ---------------------------------------------------------
# Redis Global Shared State
# ---------------------------------------------------------
# Connects the distributed RateGuard replicas to the shared Redis instance.
# Redis inherently maintains the Atomic Lua script evaluation to calculate rate tokens.
REDIS_HOST=redis
REDIS_PORT=6379     # Default unencrypted Redis binding
REDIS_DB=0          # Database index containing the keys

# ---------------------------------------------------------
# Token Bucket Algorithm Constraints
# ---------------------------------------------------------
# Calculates mathematical simulated bounds tracking sustained access velocity versus spontaneous burst traffic spikes.
REFILL_RATE=1       # The mathematical continuous addition rate (e.g. 1 new token allocated per second).
BURST_CAPACITY=5    # The absolute ceiling (max queue depth) determining the absolute maximum instantaneous requests dynamically allowed prior to triggering 429 timeouts.

# ---------------------------------------------------------
# Upstream Request Intercept Mapping
# ---------------------------------------------------------
# Targets the absolute backend endpoint that the Gateway physically proxies incoming requests over to asynchronously.
BACKEND_URL=http://backend:5001
